---
import FancyLink from '../../../astro/components/FancyLink.astro';
import Video from '../../../astro/components/Video.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Astro" currentPath={Astro.url.pathname}>
  <h1>Astro</h1>

  <p>
    Reusable Astro components, layouts, error pages, and stylesheets. Derive a
    project's root layout from <code>astro/layouts/LayoutBase.astro</code> to
    get started. This layout:
  </p>

  <ul>
    <li>Sets all text to use Arial by default.</li>
    <li>
      Provides the <code>sr-only</code> CSS class that makes text visible only to
      screen readers.
    </li>
  </ul>

  <p>The following optional files are included and may be copied as-is:</p>

  <ul>
    <li>
      <code>pages/404.astro</code> - Basic 404 page that inherits the default
      layout and links to the homepage.
    </li>
    <li>
      <code>public/_headers</code> - Cache all assets for 7 days if using
      Cloudflare Pages. Browsers will revalidate the requested <code>*.html</code>
      file.
    </li>
  </ul>

  <h2>Components</h2>

  <h3><code>FancyLink</code></h3>
  <p>
    A link with an icon in place of the bullet, indended for use within a <code>ul.links-list</code>
  </p>

  <p>
    Requires the <a href="https://github.com/natemoo-re/astro-icon"></a> package.
  </p>

  <ul class="links-list">
    <FancyLink name="GitHub" icon="cib:github" href="https://github.com/kieranknowles1/selwonklib">GitHub</FancyLink>
    <FancyLink name="Git" icon="cib:git" href="https://git.selwonk.uk/selwonksoftware/selwonklib">Forgejo</FancyLink>
  </ul>

  <h3><code>Video</code></h3>
  <p>Embed a self-hosted video, style using the <code>video</code> CSS class.</p>
  <Video url='https://r2.selwonk.uk/blitzbox.webm' />
</Layout>
