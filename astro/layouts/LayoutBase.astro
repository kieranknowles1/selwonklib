---
import type { ImageMetadata } from 'astro'

interface Props {
    favicon?: ImageMetadata,
    title: string,
}

const {
    favicon,
    title
} = Astro.props

import '../styles/base.css'
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        {favicon && <link rel="icon" href={favicon.src} />}
		<title>{title}</title>
	</head>
	<body>
        <slot />
	</body>
</html>
